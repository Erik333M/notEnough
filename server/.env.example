# Copy to .env and adjust. Every value has a working dev default.

# Port the API listens on. The mobile client assumes 4000 unless
# EXPO_PUBLIC_API_URL is set on the app side.
PORT=4000

# Signing key for session tokens. Required in production — the server refuses
# to boot without it when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string

# How long a session token stays valid.
TOKEN_TTL=30d

# Where the JSON database file lives.
DB_FILE=./data/db.json
